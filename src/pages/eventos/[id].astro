---
export const prerender = false; // rutas dinámicas se renderizan en server
import { EventosId } from "../../components/react/eventosId";
import "../../styles/global.css";
import layout from "../../layouts/Layout.astro";

const { id } = Astro.params;

if (!id) {
  // Esto evita que Vercel Serverless crashee
  throw new Error("Evento no encontrado");
}
---
<section class="bg-gray-950 min-h-screen">
  <!-- El componente React cargará los datos desde Firebase en el cliente -->
  <EventosId id={id} client:load />
</section>
